        "smoothing": "Laplace (Add-one)",
        "formulas": {
          "unigram": "P(w) = (count(w) + 1) / (total_words + vocab_size)",
          "bigram": "P(w2|w1) = (count(w1,w2) + 1) / (count(w1) + vocab_size)",
          "trigram": "P(w3|w1,w2) = (count(w1,w2,w3) + 1) / (count(w1,w2) + vocab_size)"
        },
